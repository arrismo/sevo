# Copy to .env only when overriding defaults. Never commit the resulting .env.
SEVO_PORT=3000
SEVO_AGENT_ENABLED=true
HERMES_TIMEOUT_SECONDS=240
HERMES_MAX_ITERATIONS=2
# false uses Hermes tool selection; true enables deterministic keyword routing as a fallback.
HERMES_FAST_PATH=false
SEVO_RECENT_WINDOW_HOURS=48

# X integration. Keep fake until you have a read-only OAuth 2.0 user token.
SEVO_X_SOURCE=fake
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CLIENT_TYPE=public
X_REDIRECT_URI=http://127.0.0.1:3000/x/callback
X_BEARER_TOKEN=
X_REFRESH_TOKEN=
X_USER_ID=
X_API_BASE_URL=https://api.x.com
X_TIMELINE_LIMIT=20

# LM Studio runs on the macOS host. Leave MODEL blank to use the loaded model.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_CONTEXT_LENGTH=16384
